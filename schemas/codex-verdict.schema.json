{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "codex-verdict.schema.json",
  "title": "Codex Verdict",
  "description": "Structured verdict from Codex review of an airlock tool invocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "risk_level",
    "confidence",
    "policy_hits",
    "reasons",
    "missing_context",
    "conditions"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["allow", "ask", "deny"]
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "policy_hits": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128
      },
      "maxItems": 32
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      },
      "minItems": 1,
      "maxItems": 16
    },
    "missing_context": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 256
      },
      "maxItems": 16
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      },
      "maxItems": 8
    }
  }
}
